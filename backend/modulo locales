          `,
          [idLocal, IDusuario]
        );

      if (!local) {
        throw new Error(
          'No tiene permisos sobre este local o el local no existe'
        );
      }

      const nuevoEstado =
        local.es_activo === 1
          ? 0
          : 1;

      await conn.query(
        `
        UPDATE locales
        SET es_activo = ?
        WHERE id = ?
        `,
        [nuevoEstado, idLocal]
      );

      return {
        message:
          `Estado del local modificado a: ${
            nuevoEstado === 1
              ? 'Abierto / Activo'
              : 'Cerrado / Inactivo'
          }`,
        es_activo: nuevoEstado
      };
    }

    const [[local]] =
      await conn.query(
        `
        SELECT
          id,
          es_activo
        FROM locales
        WHERE id = ?
        `,
        [idLocal]
      );

    if (!local) {
      throw new Error(
        'Local no encontrado'
      );
    }

    const nuevoEstado =
      local.es_activo === 1
        ? 0
        : 1;

    await conn.query(
      `
      UPDATE locales
      SET es_activo = ?
      WHERE id = ?
      `,
      [nuevoEstado, idLocal]
    );

    return {
      message:
        `Estado del local modificado a: ${
          nuevoEstado === 1
            ? 'Abierto / Activo'
            : 'Cerrado / Inactivo'
        }`,
      es_activo: nuevoEstado
    };

  } finally {
    conn.release();
  }
