  const [metodosPago] = await pool.query(`
    SELECT 
      mp.nombre AS metodo,
      COUNT(o.id) AS cantidad,
      ROUND((COUNT(o.id) * 100.0 / (SELECT COUNT(*) FROM ordenes)), 2) AS porcentaje
    FROM ordenes o
    JOIN metodos_pago mp ON o.IDmetodo_pago = mp.id
