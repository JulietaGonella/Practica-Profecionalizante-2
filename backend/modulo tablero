    JOIN hitorial_estado_orden h ON o.id = h.IDorden AND h.IDestado = o.IDestado
    GROUP BY DATE(h.creado_en)
    ORDER BY fecha ASC
  `);

  return {
    kpis: kpis[0],
    distribucion_categorias: categorias,
    metodos_pago: metodosPago,
