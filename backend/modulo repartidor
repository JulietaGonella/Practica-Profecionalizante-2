// En repartidores.service.js
export const getVehiculosPendientesService = async (estado = null) => {
  // Si no se pasa un estado específico, traemos ambos estados pendientes por defecto
  const estadosAFiltrar = estado 
    ? [String(estado).toUpperCase()] 
    : ['PENDIENTE', 'PENDIENTE_DOCUMENTACION'];

  const [rows] = await pool.query(
    `
    SELECT 
        v.*,
        r.id AS IDrepartidor,
        u.username,
        u.nombre,
        u.apellido,
        u.email,
        tv.nombre AS tipo_vehiculo,
        -- CORRECCIÓN: Es nuevo vehículo si el repartidor YA tenía otro vehículo aprobado anteriormente
        CASE 
            WHEN (
                SELECT COUNT(*) 
                FROM vehiculos_repartidor v_ant 
                WHERE v_ant.IDrepartidor = r.id 
                  AND v_ant.id <> v.id 
                  AND v_ant.estado = 'APROBADO'
            ) > 0 THEN 1 
            ELSE 0 
        END AS es_nuevo_vehiculo
    FROM vehiculos_repartidor v
    JOIN repartidores r ON v.IDrepartidor = r.id
    JOIN usuarios u ON r.IDusuario = u.id
    JOIN tipos_vehiculo tv ON v.IDtipo_vehiculo = tv.id
    WHERE v.estado IN (?)
    ORDER BY v.id DESC
    `,
    [estadosAFiltrar]
  );

  // Mapear para entregar la estructura clara con bloques separando actual/nuevo y la bandera de es_nuevo_vehiculo
  return rows.map(v => ({
    id: v.id,
    es_nuevo_vehiculo: Boolean(v.es_nuevo_vehiculo),
    repartidor: {
      id: v.IDrepartidor,
      nombre_completo: `${v.nombre || ''} ${v.apellido || ''}`.trim() || v.username,
      email: v.email,
      dni: v.dni
    },
    vehiculo: {
      tipo: v.tipo_vehiculo,
      marca: v.marca,
      modelo: v.modelo,
      patente: v.patente
    },
    // 📂 Documentación Actual / Anterior (Lo que ya tiene aprobado)
    documentacion_actual: {
      cedula_url: v.cedula_url,
      fecha_vencimiento_cedula: v.fecha_vencimiento_cedula,
      seguro_url: v.seguro_url,
      fecha_vencimiento_seguro: v.fecha_vencimiento_seguro,
      licencia_url: v.licencia_url,
      fecha_vencimiento_licencia: v.fecha_vencimiento_licencia
    },
    // 📂 Documentación Nueva / Renovada (Lo que subió para actualizar)
    documentacion_nueva: {
      cedula_url: v.nueva_cedula_url,
      fecha_vencimiento_cedula: v.nueva_fecha_vencimiento_cedula,
      seguro_url: v.nuevo_seguro_url,
      fecha_vencimiento_seguro: v.nueva_fecha_vencimiento_seguro,
      licencia_url: v.nueva_licencia_url,
      fecha_vencimiento_licencia: v.nueva_fecha_vencimiento_licencia
    },
    estado: v.estado
  }));
};

export const revisarVehiculoService = async (IDvehiculo, estado, motivoRechazo = null) => {
  const estadoNormalizado = String(estado).toUpperCase();
  if (!['APROBADO', 'RECHAZADO'].includes(estadoNormalizado)) {
    throw new Error('El estado debe ser APROBADO o RECHAZADO');
  }

  if (estadoNormalizado === 'RECHAZADO' && !String(motivoRechazo || '').trim()) {
    throw new Error('El motivo de rechazo es obligatorio');
  }

  const conn = await pool.getConnection();
  try {
    await conn.beginTransaction();

    // 1. Verificar que el vehículo exista y traer todos los campos necesarios
    const [[vehiculo]] = await conn.query(
      `SELECT * FROM vehiculos_repartidor WHERE id = ?`,
      [IDvehiculo]
    );

    if (!vehiculo) {
      throw new Error('Vehículo no encontrado');
    }

    let mensajeRespuesta;

    // 2. Manejo específico si la revisión corresponde a una actualización por vencimiento de documentación
    if (vehiculo.estado === 'PENDIENTE_DOCUMENTACION') {
      if (estadoNormalizado === 'APROBADO') {
        // Reemplazar los datos viejos con los nuevos si existen, limpiar temporales y dejar el vehículo APROBADO y activo
        await conn.query(
          `
          UPDATE vehiculos_repartidor
          SET 
            cedula_url = COALESCE(nueva_cedula_url, cedula_url),
            fecha_vencimiento_cedula = COALESCE(nueva_fecha_vencimiento_cedula, fecha_vencimiento_cedula),
            seguro_url = COALESCE(nuevo_seguro_url, seguro_url),
            fecha_vencimiento_seguro = COALESCE(nueva_fecha_vencimiento_seguro, fecha_vencimiento_seguro),
            licencia_url = COALESCE(nueva_licencia_url, licencia_url),
            fecha_vencimiento_licencia = COALESCE(nueva_fecha_vencimiento_licencia, fecha_vencimiento_licencia),
            nueva_cedula_url = NULL, nueva_fecha_vencimiento_cedula = NULL,
            nuevo_seguro_url = NULL, nueva_fecha_vencimiento_seguro = NULL,
            nueva_licencia_url = NULL, nueva_fecha_vencimiento_licencia = NULL,
            estado = 'APROBADO',
            activo = 1,
            motivo_rechazo = NULL,
            motivo_rechazo_documentacion = NULL
          WHERE id = ?
          `,
          [IDvehiculo]
        );
        mensajeRespuesta = 'Actualización de documentación aprobada correctamente.';
      } else {
        // Rechazar actualización: descartar cambios nuevos, limpiar temporales, volver a APROBADO y guardar el motivo
        await conn.query(
          `
          UPDATE vehiculos_repartidor
          SET 
            nueva_cedula_url = NULL, nueva_fecha_vencimiento_cedula = NULL,
            nuevo_seguro_url = NULL, nueva_fecha_vencimiento_seguro = NULL,
            nueva_licencia_url = NULL, nueva_fecha_vencimiento_licencia = NULL,
            estado = 'APROBADO',
            activo = 1,
            motivo_rechazo_documentacion = ?
          WHERE id = ?
          `,
          [String(motivoRechazo).trim(), IDvehiculo]
        );
        mensajeRespuesta = 'Actualización de documentación rechazada. El vehículo conserva su documentación anterior.';
      }

    } else {
      // 3. Lógica existente para vehículos nuevos ('PENDIENTE') o solicitudes de baja ('PENDIENTE_BAJA')
      let nuevoEstadoVehiculo;
      let activoValor;

      if (estadoNormalizado === 'APROBADO') {
        nuevoEstadoVehiculo = vehiculo.estado === 'PENDIENTE_BAJA' ? 'BAJA' : 'APROBADO';
        activoValor = vehiculo.estado === 'PENDIENTE_BAJA' ? 0 : 1;
        mensajeRespuesta = 'Vehículo aprobado correctamente.';

        await conn.query(
          `UPDATE vehiculos_repartidor 
           SET estado = ?, activo = ?, motivo_rechazo = NULL 
           WHERE id = ?`,
          [nuevoEstadoVehiculo, activoValor, IDvehiculo]
        );

      } else {
        if (vehiculo.estado === 'PENDIENTE_BAJA') {
          nuevoEstadoVehiculo = 'APROBADO';
          activoValor = 1;
          mensajeRespuesta = 'Solicitud de baja rechazada. El vehículo sigue activo.';
        } else {
          nuevoEstadoVehiculo = 'RECHAZADO';
          activoValor = 0;
          mensajeRespuesta = 'Solicitud rechazada. El vehículo ha sido marcado como rechazado.';
        }

        await conn.query(
          `UPDATE vehiculos_repartidor 
           SET estado = ?, activo = ?, motivo_rechazo = ? 
           WHERE id = ?`,
          [nuevoEstadoVehiculo, activoValor, String(motivoRechazo).trim(), IDvehiculo]
        );

        if (nuevoEstadoVehiculo === 'RECHAZADO') {
          await conn.query(
            `UPDATE repartidores SET IDvehiculo_activo = NULL WHERE id = ? AND IDvehiculo_activo = ?`,
            [vehiculo.IDrepartidor, IDvehiculo]
          );
        }
      }
    }

    await conn.commit();
    return { message: mensajeRespuesta };

  } catch (error) {
    await conn.rollback();
    throw error;
  } finally {
    conn.release();
  }
};

