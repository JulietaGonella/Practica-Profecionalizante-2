  const [result] = await pool.query(
    `
    INSERT INTO vehiculos_repartidor
      (IDrepartidor, IDtipo_vehiculo, marca, modelo, anio, patente,
       seguro_vigente, licencia_vigente, bici_propia, cedula_url,
       seguro_url, licencia_url, 
