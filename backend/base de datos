-- 2️⃣ Migrar direcciones existentes desde 'clientes' hacia 'direcciones_cliente'
INSERT INTO direcciones_cliente (IDusuario, alias, direccion, piso, departamento, referencia, latitud, longitud, es_principal)
SELECT 
    IDusuario, 
    'Principal' AS alias, 
    direccion, 
    piso, 
    departamento, 
    referencia, 
    COALESCE(latitud, -32.40800000) AS latitud, 
    COALESCE(longitud, -63.24100000) AS longitud, 
    1 AS es_principal
FROM clientes
WHERE direccion IS NOT NULL AND direccion != '';

