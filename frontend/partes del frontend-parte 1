      }

      const nuevaCantidad = Math.max(0, cantidadActual + delta);
      const nuevoGrupo = { ...grupoActual };

      if (nuevaCantidad > 0) {
        nuevoGrupo[opcionId] = nuevaCantidad;
      } else {
        delete nuevoGrupo[opcionId];
      }

      return {
        ...prev,
        [grupoId]: nuevoGrupo
      };
    });
