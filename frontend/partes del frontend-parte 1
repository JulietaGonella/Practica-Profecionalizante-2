                            onClick={() => handleCantidadChange(grupo.id, opcion.id, 1, grupo.max_seleccion)}
                            style={{ width: '28px', height: '28px', borderRadius: '4px', border: '1px solid #ccc', cursor: 'pointer' }}
                          >
                            +
